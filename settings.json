{
  "languages": {
    "Python": {
      "enable_language_server": true,
      "tasks": {
        "prefer_lsp": true
      }
    },
    "JavaScript": {
      "formatter": "prettier",
      "format_on_save": "on"
    },
    "JSX": {
      "formatter": "prettier",
      "format_on_save": "on"
    },
    "TypeScript": {
      "formatter": "prettier",
      "format_on_save": "on"
    },
    "TSX": {
      "formatter": "prettier",
      "format_on_save": "on"
    }
  },
  "project_panel": {
    "dock": "left",
  },
  "icon_theme": "VSCode Icons for Zed (Dark Angular)",
  "ui_font_size": 20,
  "buffer_font_size": 18,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Ayu Dark",
  },
  "show_edit_predictions": false,
  "soft_wrap": "editor_width",
  "inlay_hints": {
    "enabled": true,
  },
  "tab_size": 4,
  "hard_tabs": true,
}
